function Retinol:Tab(data)
    local tab = {}
    tab.Name = data.Title or "Tab"

    local btn = new("TextButton", {
        Size = UDim2.new(1, -10, 0, 32),
        BackgroundColor3 = CONFIG.Panel2,
        BorderSizePixel = 0,
        Text = "  " .. tab.Name,
        TextColor3 = CONFIG.Dim,
        Font = CONFIG.FontBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
    }, TabScroll)
    corner(btn, 8)

    local page = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, ContentScroll)
    local pageList = new("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.page.Visible = false
            TweenService:Create(t.btn, TweenInfo.new(0.15), {BackgroundColor3 = CONFIG.Panel2, TextColor3 = CONFIG.Dim}):Play()
        end
        page.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = CONFIG.Accent, TextColor3 = Color3.new(1,1,1)}):Play()
        CurrentTab = tab
    end)

    tab.btn = btn
    tab.page = page
    tab.list = pageList
    Tabs[#Tabs + 1] = tab

    if #Tabs == 1 then
        page.Visible = true
        btn.BackgroundColor3 = CONFIG.Accent
        btn.TextColor3 = Color3.new(1,1,1)
        CurrentTab = tab
    end

    function tab:Section(title)
        local s = new("Frame", {
            Size = UDim2.new(1, -8, 0, 26),
            BackgroundTransparency = 1,
        }, page)
        new("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = string.upper(title or "Section"),
            TextColor3 = CONFIG.Accent2,
            Font = CONFIG.FontBold,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, s)
        local line = new("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            Position = UDim2.new(0, 0, 1, -2),
            BackgroundColor3 = CONFIG.Border,
            BorderSizePixel = 0,
        }, s)
        gradient(line, CONFIG.Accent, CONFIG.Border, 0)
        return s
    end

    function tab:Toggle(data)
        local state = data.Value or false
        local frame = new("Frame", {
            Size = UDim2.new(1, -8, 0, 40),
            BackgroundColor3 = CONFIG.Panel,
            BorderSizePixel = 0,
        }, page)
        corner(frame, 8)
        stroke(frame, CONFIG.Border, 1, 0.5)
        new("TextLabel", {
            Size = UDim2.new(1, -70, 0, 20),
            Position = UDim2.new(0, 12, 0, 4),
            BackgroundTransparency = 1,
            Text = data.Title or "Toggle",
            TextColor3 = CONFIG.Text,
            Font = CONFIG.FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        new("TextLabel", {
            Size = UDim2.new(1, -70, 0, 14),
            Position = UDim2.new(0, 12, 0, 22),
            BackgroundTransparency = 1,
            Text = data.Desc or "",
            TextColor3 = CONFIG.Dim,
            Font = CONFIG.Font,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        local track = new("Frame", {
            Size = UDim2.new(0, 36, 0, 20),
            Position = UDim2.new(1, -50, 0.5, -10),
            BackgroundColor3 = state and CONFIG.Accent or CONFIG.Panel2,
            BorderSizePixel = 0,
        }, frame)
        corner(track, 10)
        stroke(track, CONFIG.Border, 1, 0.3)
        local knob = new("Frame", {
            Size = UDim2.new(0, 16, 0, 16),
            Position = state and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2),
            BackgroundColor3 = Color3.new(1,1,1),
            BorderSizePixel = 0,
        }, track)
        corner(knob, 8)
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
        }, frame)
        btn.MouseButton1Click:Connect(function()
            state = not state
            TweenService:Create(track, TweenInfo.new(0.2), {BackgroundColor3 = state and CONFIG.Accent or CONFIG.Panel2}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2)}):Play()
            if data.Callback then data.Callback(state) end
        end)
        return frame
    end

    function tab:Slider(data)
        local min = data.Value.Min
        local max = data.Value.Max
        local val = data.Value.Default
        local frame = new("Frame", {
            Size = UDim2.new(1, -8, 0, 52),
            BackgroundColor3 = CONFIG.Panel,
            BorderSizePixel = 0,
        }, page)
        corner(frame, 8)
        stroke(frame, CONFIG.Border, 1, 0.5)
        new("TextLabel", {
            Size = UDim2.new(1, -70, 0, 20),
            Position = UDim2.new(0, 12, 0, 4),
            BackgroundTransparency = 1,
            Text = data.Title or "Slider",
            TextColor3 = CONFIG.Text,
            Font = CONFIG.FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        local valLbl = new("TextLabel", {
            Size = UDim2.new(0, 60, 0, 20),
            Position = UDim2.new(1, -72, 0, 4),
            BackgroundTransparency = 1,
            Text = tostring(val),
            TextColor3 = CONFIG.Accent2,
            Font = CONFIG.FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, frame)
        local track = new("Frame", {
            Size = UDim2.new(1, -24, 0, 6),
            Position = UDim2.new(0, 12, 0, 34),
            BackgroundColor3 = CONFIG.Panel2,
            BorderSizePixel = 0,
        }, frame)
        corner(track, 3)
        local fill = new("Frame", {
            Size = UDim2.new((val - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = CONFIG.Accent,
            BorderSizePixel = 0,
        }, track)
        corner(fill, 3)
        gradient(fill, CONFIG.Accent, CONFIG.Accent2, 0)
        local dragging = false
        local function update(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * rel)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            valLbl.Text = tostring(val)
            if data.Callback then data.Callback(val) end
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        return frame
    end

    function tab:Button(data)
        local frame = new("Frame", {
            Size = UDim2.new(1, -8, 0, 40),
            BackgroundColor3 = CONFIG.Panel,
            BorderSizePixel = 0,
        }, page)
        corner(frame, 8)
        stroke(frame, CONFIG.Border, 1, 0.5)
        new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 20),
            Position = UDim2.new(0, 12, 0, 4),
            BackgroundTransparency = 1,
            Text = data.Title or "Button",
            TextColor3 = CONFIG.Text,
            Font = CONFIG.FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        new("TextLabel", {
            Size = UDim2.new(1, -20, 0, 14),
            Position = UDim2.new(0, 12, 0, 22),
            BackgroundTransparency = 1,
            Text = data.Desc or "",
            TextColor3 = CONFIG.Dim,
            Font = CONFIG.Font,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
        }, frame)
        btn.MouseButton1Click:Connect(function()
            TweenService:Create(frame, TweenInfo.new(0.1), {BackgroundColor3 = CONFIG.Accent}):Play()
            task.delay(0.1, function()
                TweenService:Create(frame, TweenInfo.new(0.2), {BackgroundColor3 = CONFIG.Panel}):Play()
            end)
            if data.Callback then data.Callback() end
        end)
        return frame
    end

    function tab:Dropdown(data)
        local open = false
        local selected = data.Value or (data.Values and data.Values[1]) or ""
        local frame = new("Frame", {
            Size = UDim2.new(1, -8, 0, 40),
            BackgroundColor3 = CONFIG.Panel,
            BorderSizePixel = 0,
            ClipsDescendants = true,
        }, page)
        corner(frame, 8)
        stroke(frame, CONFIG.Border, 1, 0.5)
        new("TextLabel", {
            Size = UDim2.new(1, -80, 0, 20),
            Position = UDim2.new(0, 12, 0, 4),
            BackgroundTransparency = 1,
            Text = data.Title or "Dropdown",
            TextColor3 = CONFIG.Text,
            Font = CONFIG.FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
        local valLbl = new("TextLabel", {
            Size = UDim2.new(0, 90, 0, 20),
            Position = UDim2.new(1, -102, 0, 4),
            BackgroundTransparency = 1,
            Text = tostring(selected),
            TextColor3 = CONFIG.Accent2,
            Font = CONFIG.FontBold,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, frame)
        local list = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            Position = UDim2.new(0, 0, 0, 36),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
        }, frame)
        new("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, list)
        for _, opt in ipairs(data.Values or {}) do
            local ob = new("TextButton", {
                Size = UDim2.new(1, -16, 0, 26),
                BackgroundColor3 = CONFIG.Panel2,
                BorderSizePixel = 0,
                Text = "  " .. tostring(opt),
                TextColor3 = CONFIG.Text,
                Font = CONFIG.Font,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            }, list)
            corner(ob, 6)
            ob.MouseButton1Click:Connect(function()
                selected = opt
                valLbl.Text = tostring(opt)
                open = false
                TweenService:Create(frame, TweenInfo.new(0.2), {Size = UDim2.new(1, -8, 0, 40)}):Play()
                if data.Callback then data.Callback(opt) end
            end)
        end
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Text = "",
        }, frame)
        btn.MouseButton1Click:Connect(function()
            open = not open
            local target = 40
            if open then
                target = 40 + ((#(data.Values or {}) * 28) + 4)
            end
            TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -8, 0, target)}):Play()
        end)
        return frame
    end

    return tab
end

